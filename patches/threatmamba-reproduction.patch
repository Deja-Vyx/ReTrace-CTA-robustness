 def pos_view(g: dict, noise_std: float = 0.05, edge_drop: float = 0.1,
@@ -68,3 +68,48 @@ def neg_splice(g1: dict, g2: dict, tac_order: list[str], phi: int | None = None,
             "node_types": node_types, "node_values": node_values, "node_sent": node_sent,
             "x": x, "edges": torch.tensor(edges, dtype=torch.long) if edges else torch.zeros(0, 3, dtype=torch.long),
             "states": merged_states, "n_sents": max(g1.get("n_sents", 0), g2.get("n_sents", 0) + phi)}
+
+
+# ---------------------------------------------------------------------------------------------
+# [ReTrace] same-size contrastive negatives (optional; the default training path is unchanged)
+def truncate_tail(g: dict, keep_frac: float) -> dict:
+    """Mirror of truncate_graph: keep the LAST k% of the timeline (in State order), drop nodes whose
+    node_sent lies before the cut and keep the edges between the remaining nodes.
+    Note: every node only carries the FIRST sentence that mentions it, so an IOC/TTP first seen
+    before the cut is dropped (an approximation)."""
+    states = g["states"]
+    if not states or keep_frac >= 1.0:
+        return g
+    k = max(1, int(round(len(states) * keep_frac)))
+    min_sent = g["node_sent"][states[-k]]
+    keep = [i for i in range(len(g["node_types"])) if g["node_sent"][i] >= min_sent]
+    remap = {old: new for new, old in enumerate(keep)}
+    keepset = set(keep)
+    edges = [(remap[u], remap[v], r) for u, v, r in g["edges"].tolist()
+             if u in keepset and v in keepset]
+    return {**g,
+            "node_types": [g["node_types"][i] for i in keep],
+            "node_values": [g["node_values"][i] for i in keep],
+            "node_sent": [g["node_sent"][i] for i in keep],
+            "x": g["x"][keep],
+            "edges": torch.tensor(edges, dtype=torch.long) if edges else torch.zeros(0, 3, dtype=torch.long),
+            "states": [remap[s] for s in states[-k:] if s in keepset]}
+
+
+def neg_splice_matched(g1: dict, g2: dict, tac_order: list[str], phi: float | None = None,
+                       rng: random.Random | None = None) -> dict:
+    """Eq. 8 taken literally: the first phi of g1's timeline + the last (1 - phi) of g2's, chained.
+    The negative is about the size of one graph (instead of twice the size, as with neg_splice)."""
+    rng = rng or random
+    if phi is None:
+        phi = rng.uniform(0.2, 0.8)
+    head = truncate_graph(g1, phi)
+    tail = truncate_tail(g2, 1.0 - phi)
+    if not head["node_sent"] or not tail["node_sent"]:
+        return neg_splice(g1, g2, tac_order, rng=rng)
+    off = max(head["node_sent"]) + 1 - min(tail["node_sent"])
+    if off == 0:  # neg_splice treats phi=0 as "pick at random"; for a zero offset shift by one more sentence
+        off = 1
+    out = neg_splice(head, tail, tac_order, phi=off, rng=rng)
+    out["doc_id"] = g1["doc_id"] + "|negm|" + g2["doc_id"]
+    return out
